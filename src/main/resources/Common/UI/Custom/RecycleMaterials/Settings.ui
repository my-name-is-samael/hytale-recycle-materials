$C = "../Common.ui";
$S = "Styles.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 560, Height: 790);

    #Title {
        $C.@Title {
            @Text = %recyclematerials.ui.title;
        }
    }

    #Content {
        LayoutMode: Top;

        Label {
            Anchor: (Height: 30);
            Text: %recyclematerials.ui.subtitle;
            Style: $S.@Note;
        }

        Label {
            Anchor: (Height: 22);
            Text: %recyclematerials.ui.section.presets;
            Style: $S.@Caps;
        }

        Group #Presets {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 34);

            TextButton #PresetFull {
                FlexWeight: 1;
                Anchor: (Height: 30, Right: 6);
                Text: %recyclematerials.ui.preset.full;
                Style: $S.@PanelButton;
            }
            TextButton #PresetBuilding {
                FlexWeight: 1;
                Anchor: (Height: 30, Right: 6);
                Text: %recyclematerials.ui.preset.building;
                Style: $S.@PanelButton;
            }
            TextButton #PresetMinimal {
                FlexWeight: 1;
                Anchor: (Height: 30, Right: 6);
                Text: %recyclematerials.ui.preset.minimal;
                Style: $S.@PanelButton;
            }
            TextButton #PresetNone {
                FlexWeight: 1;
                Anchor: (Height: 30);
                Text: %recyclematerials.ui.preset.none;
                Style: $S.@PanelButton;
            }
        }

        Label #PresetStatus {
            Anchor: (Height: 22);
            Style: $S.@Note;
        }

        Group {
            Anchor: (Height: 8);
        }

        Label {
            Anchor: (Height: 22);
            Text: %recyclematerials.ui.group.structure;
            Style: $S.@Caps;
        }

        Group #StructureRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Height: 294);
        }

        Group {
            Anchor: (Height: 8);
        }

        Label {
            Anchor: (Height: 22);
            Text: %recyclematerials.ui.group.materials;
            Style: $S.@Caps;
        }

        Group #MaterialsRows {
            LayoutMode: Top;
            Anchor: (Left: 0, Right: 0, Height: 126);
        }

        Group {
            Anchor: (Height: 8);
        }

        Label {
            Anchor: (Height: 22);
            Text: %recyclematerials.ui.group.craftTime;
            Style: $S.@Caps;
        }

        Group {
            LayoutMode: Left;
            Anchor: (Left: 0, Right: 0, Height: 28);

            $C.@Slider #CraftTime {
                @Anchor = (Width: 400, Right: 20);
                Value: 0;
                Min: 0;
                Max: 10;
                Step: 1;
            }

            Label #CraftTimeValue {
                Text: "0.0 s";
                Style: $S.@RowLabel;
            }
        }

        Label {
            Anchor: (Height: 20);
            Text: %recyclematerials.ui.craftTime.desc;
            Style: $S.@Note;
        }

        Label {
            Anchor: (Top: 10, Height: 20);
            Text: %recyclematerials.ui.footer;
            Style: $S.@Note;
        }
    }
}

$C.@BackButton {}
